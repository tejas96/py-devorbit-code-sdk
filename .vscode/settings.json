{
  // Python Configuration
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,

  // ============================================================
  // FORMATTING - All tools read from pyproject.toml
  // ============================================================
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    // IMPORTANT: Disable auto organize imports - let isort handle it via pyproject.toml
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },

  // Black formatter - use pyproject.toml settings
  "black-formatter.args": [
    "--config=${workspaceFolder}/pyproject.toml"
  ],

  // isort - MUST use pyproject.toml to match CI
  "isort.args": [
    "--settings-path=${workspaceFolder}/pyproject.toml"
  ],
  "isort.check": true,

  // Ruff linter - reads from pyproject.toml automatically
  "ruff.lint.enable": true,
  "ruff.lint.run": "onSave",
  "ruff.configuration": "${workspaceFolder}/pyproject.toml",

  // Mypy settings
  "mypy.enabled": true,
  "mypy.runUsingActiveInterpreter": true,
  "mypy.targets": [
    "src/devorbit"
  ],
  "mypy.configFile": "${workspaceFolder}/pyproject.toml",

  // Editor settings for Python
  "editor.rulers": [100],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // File exclude patterns
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "**/.coverage": true,
    "**/htmlcov": true,
    "**/.DS_Store": true
  },

  // Search exclude patterns
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "**/.coverage": true,
    "**/htmlcov": true,
    "**/node_modules": true,
    "**/.git": true
  },

  // Testing
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests",
    "-v"
  ],

  // Auto-save - on focus change (not on type)
  "files.autoSave": "onFocusChange",

  // Editor improvements
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.snippetSuggestions": "top",
  "editor.wordBasedSuggestions": "off"
}
